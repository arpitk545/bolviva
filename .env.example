# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit `.env.local` or paste the real key in chat / public posts.

# Gnani AI API key (from the Gnani dashboard after registration approval).
# Without this key the app runs fully in MOCK MODE (see README).
GNANI_API_KEY=

# Optional: override once the official Gnani REST endpoints are confirmed
# from the Gnani API documentation / dashboard. Leave empty until then.
GNANI_STT_ENDPOINT=
GNANI_TTS_ENDPOINT=
